{
  "extraction": [
    {
      "id": "identity_name",
      "windows": [
        ["My name is Mira."]
      ],
      "expected": [
        {"kinds": ["identity"], "concepts": [["Mira"]]}
      ],
      "category": "identity",
      "questions": [
        {"text": "What is my name? If you do not know, say unknown.", "answers": ["Mira"], "abstain": false},
        {"text": "What is my surname?", "answers": ["UNKNOWN"], "abstain": true}
      ]
    },
    {
      "id": "identity_employer",
